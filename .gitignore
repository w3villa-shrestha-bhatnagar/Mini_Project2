# =================================================================
# Git Ignore Configuration for AuraMart Fullstack Project
# =================================================================

# Environment & Secret Files (Keep .env.example tracked)
.env
.env.*
!.env.example
*.env.local
backend/.env
frontend/.env

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local Runtime Data & Uploads
backend/data/*.json
backend/static/avatars/*
!backend/static/avatars/.gitkeep

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
