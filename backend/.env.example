# =================================================================
# AuraMart Backend Environment Configuration
# Replace the placeholder values with your real credentials.
# =================================================================

# Server & Security
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=auramart_super_secret_jwt_key_development_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
# Provide your local MongoDB or MongoDB Atlas URI.
# If MongoDB is unreachable, the system automatically uses an in-memory/file fallback.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.9q5r2wv.mongodb.net/auramart?retryWrites=true&w=majority
MONGODB_DB_NAME=auramart

# Razorpay Payment Gateway Credentials
# Get these from https://dashboard.razorpay.com/#/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHererzp_test_TgY3Hkeu4pOPXE
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# Cloudinary Media Storage Credentials
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth2 Credentials
# Get these from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook Login Credentials (Optional)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# SMTP Email Configuration (for sending email verification links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=no-reply@auramart.com

# Default Admin Account (seeded automatically on first startup)
ADMIN_NAME=AuraMart Administrator
ADMIN_EMAIL=admin@auramart.com
ADMIN_PASSWORD=Admin@123

# Plan Expiration Cron Job Interval (in seconds)
CRON_INTERVAL_SECONDS=30
