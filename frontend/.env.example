# =================================================================
# AuraMart Frontend Environment Configuration
# Replace the placeholder values with your real credentials.
# =================================================================

# Backend API Base URL
VITE_API_URL=http://localhost:8000/api

# Razorpay Key ID for Checkout Modal
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Google OAuth2 Client ID for Social Login
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Maps JavaScript API Key (Optional: for Google Maps autocomplete & pin)
# If empty, OpenStreetMap Leaflet & Nominatim autocomplete is automatically used
VITE_GOOGLE_MAPS_API_KEY=
